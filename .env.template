# Discord Application Public Key
# Discord Developer Portal (https://discord.com/developers/applications) から取得
# アプリケーション → General Information → Public Key
DISCORD_PUBLIC_KEY=your_discord_public_key_here
DISCORD_APP_ID=your_discord_app_id
DISCORD_TOKEN=your_discord_token

# Slash Command 定義ファイルのパス（省略時: ./src/slash_command.json）
# SLASH_COMMAND_PATH=/app/slash_command.json

# バインドアドレス（省略時: 127.0.0.1:3000）
# コンテナ環境では 0.0.0.0:3000 を指定
# BIND_ADDRESS=0.0.0.0:3000
